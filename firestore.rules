rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Resident profile rule: only the authenticated user can read and write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Emergency contacts rule: only the authenticated user can read and write their contacts
      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}